# Private config for tools/make-kiosk-url.sh — copy to slideshow.env (never commit).
# Album links are contributor-writable: treat like passwords.

# 1–5 shared albums, album-after-album order (comma-separated).
# Use the bare CloudKit id (~25 chars), or a full
# https://photos.icloud.com/shared/album/<id> URL.
# (Not the old www.icloud.com/sharedalbum/#B0… form.)
SLIDESHOW_ALBUMS=AbCdE_fgHijKlMnOpQrStUvWx,XyZ12_abCdeFgHijKlMnOpQrS

# Seconds per photo (default 5)
SLIDESHOW_INTERVAL=5

# Dissolve duration in seconds (default 0.6)
SLIDESHOW_FADE=0.6

# Unsharp-mask amount after resize (default 0.3; 0 = off)
SLIDESHOW_SHARPEN=0.3

# Optional geocoder overrides (Nominatim policy may require switching without a code change)
# SLIDESHOW_NOMINATIM_URL=https://nominatim.openstreetmap.org/reverse
# SLIDESHOW_PHOTON_URL=https://photon.komoot.io/reverse
